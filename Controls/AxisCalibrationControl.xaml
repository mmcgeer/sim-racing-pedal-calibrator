<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimRacingPedalCalibrator.AxisCalibrationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimRacingPedalCalibrator">

    <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
        <TextBlock x:Name="MappingTitleText" Text="Input Source" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox
            x:Name="AxisSourceCombo"
            Width="260"
            PlaceholderText="Select input..."
            SelectionChanged="OnAxisSourceChanged"/>
    </StackPanel>
    <TabView>
        <!-- Calibration Tab -->
        <TabViewItem Header="Calibration">
            <Grid RowSpacing="12" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock 
                    Grid.Row="0"
                    x:Name="AxisNameText"
                    Text="Axis Name"
                    Style="{StaticResource SubtitleTextBlockStyle}"/>

                <!-- Value Display -->
                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Value -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Current Value (Raw)" FontSize="12" Opacity="0.7"/>
                        <TextBlock 
                            x:Name="CurrentValueText"
                            Text="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Calibrated Value -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Calibrated (App)" FontSize="12" Opacity="0.7"/>
                        <TextBlock 
                            x:Name="CalibratedValueText"
                            Text="0%"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- PedalFX firmware output -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="PedalFX Output" FontSize="12" Opacity="0.7"/>
                        <TextBlock 
                            x:Name="FirmwareOutputText"
                            Text="n/a"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Min Value -->
                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Text="Min" FontSize="12" Opacity="0.7"/>
                        <TextBlock 
                            x:Name="MinValueText"
                            Text="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Max Value -->
                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="Max" FontSize="12" Opacity="0.7"/>
                        <TextBlock 
                            x:Name="MaxValueText"
                            Text="65535"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar for Raw Value -->
                <StackPanel Grid.Row="2" Spacing="6">
                    <ProgressBar 
                        x:Name="ValueBar"
                        Value="0"
                        Maximum="65535"
                        Height="8"
                        CornerRadius="4"/>
                    <ProgressBar 
                        x:Name="CalibratedBar"
                        Value="0"
                        Maximum="100"
                        Height="8"
                        CornerRadius="4"
                        Foreground="#FFB900"/>
                </StackPanel>

                <!-- Calibration Controls -->
                <Grid Grid.Row="3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Min Value" FontSize="12" Opacity="0.7"/>
                        <NumberBox 
                            x:Name="MinInput"
                            Minimum="0"
                            Maximum="65535"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="OnCalibrationValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Max Value" FontSize="12" Opacity="0.7"/>
                        <NumberBox 
                            x:Name="MaxInput"
                            Minimum="0"
                            Maximum="65535"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="OnCalibrationValueChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Dead Zone Control -->
                <StackPanel Grid.Row="4" Spacing="8">
                    <TextBlock Text="Dead Zone" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider 
                            Grid.Column="0"
                            x:Name="DeadZoneSlider"
                            Minimum="0"
                            Maximum="10000"
                            Value="0"
                            ValueChanged="OnDeadZoneChanged"/>
                        <TextBlock 
                            Grid.Column="1"
                            x:Name="DeadZoneValue"
                            Text="0"
                            VerticalAlignment="Center"
                            TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </TabViewItem>

        <!-- Response Curve Tab -->
        <TabViewItem Header="Response Curve">
            <Grid RowSpacing="12" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Instructions -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="Interactive 10-Point Curve" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Click and drag the blue points to customize your response curve" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <!-- Preset Buttons -->
                <StackPanel Grid.Row="1" Spacing="8" Orientation="Horizontal">
                    <TextBlock Text="Quick Presets:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    <Button Content="Racing Brake" Click="OnPresetRacingBrake" Padding="8,4"/>
                    <Button Content="Smooth Throttle" Click="OnPresetSmoothThrottle" Padding="8,4"/>
                    <Button Content="Precise Steering" Click="OnPresetPreciseSteering" Padding="8,4"/>
                    <Button Content="Linear" Click="OnPresetLinear" Padding="8,4"/>
                </StackPanel>

                <!-- Curve Graph Canvas -->
                <Border Grid.Row="2" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,12">
                    <Canvas 
                        x:Name="CurveCanvas"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        MinHeight="300"
                        SizeChanged="CurveCanvas_SizeChanged"/>
                </Border>

                <!-- Description and Stats -->
                <Grid Grid.Row="3" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel 
                        Grid.Column="0"
                        Spacing="4">
                        <TextBlock 
                            x:Name="CurveDescription"
                            Text="Linear curve - drag points to modify"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Opacity="0.7"/>
                    </StackPanel>

                    <!-- NEW: Real-time Pedal Output Display -->
                    <StackPanel 
                        Grid.Column="1"
                        Spacing="8"
                        Padding="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        
                        <TextBlock 
                            Text="Live Output"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.8"/>
                        
                        <!-- Input/Output Values -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Raw Input -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Input" FontSize="11" Opacity="0.6"/>
                                <TextBlock 
                                    x:Name="RawInputValue"
                                    Text="0%"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#0066FF"/>
                            </StackPanel>
                            
                            <!-- Arrow -->
                            <TextBlock 
                                Grid.Column="0"
                                Text="→"
                                FontSize="18"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Opacity="0.5"/>
                            
                            <!-- Curve Output -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Output" FontSize="11" Opacity="0.6"/>
                                <TextBlock 
                                    x:Name="CurveOutputValue"
                                    Text="0%"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#00AA00"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Progress Bars -->
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Input Progress -->
                            <ProgressBar 
                                Grid.Row="0"
                                x:Name="InputProgressBar"
                                Value="0"
                                Maximum="100"
                                Height="6"
                                Foreground="#0066FF"
                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"/>
                            
                            <!-- Output Progress -->
                            <ProgressBar 
                                Grid.Row="1"
                                x:Name="OutputProgressBar"
                                Value="0"
                                Maximum="100"
                                Height="6"
                                Foreground="#00AA00"
                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"/>
                        </Grid>
                    </StackPanel>
                    
                    <TextBlock 
                        Grid.Column="2"
                        x:Name="CurveDeviation"
                        Text="Deviation: 0%"
                        TextAlignment="Right"
                        FontSize="12"
                        Opacity="0.7"/>
                </Grid>

                <!-- Control Buttons -->
                <StackPanel Grid.Row="4" Spacing="8" Orientation="Horizontal">
                    <Button x:Name="ResetCurveButton" Content="Reset to Linear" Click="OnResetCurve" Padding="12,6"/>
                    <Button x:Name="SaveCurveButton" Content="💾 Save Profile" Click="OnSaveCurveProfile" Padding="12,6"/>
                    <ComboBox x:Name="LoadCurveCombo" SelectionChanged="OnLoadCurveProfile" MinWidth="150" Padding="8,6"/>
                </StackPanel>
            </Grid>
        </TabViewItem>

    </TabView>
    </StackPanel>
</UserControl>
