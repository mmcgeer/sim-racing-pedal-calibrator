<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimRacingPedalCalibrator.AxisCalibrationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimRacingPedalCalibrator">

    <TabView>
        <!-- Calibration Tab -->
        <TabViewItem Header="Calibration">
            <Grid RowSpacing="12" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock x:ConnectionId='8' 
                    Grid.Row="0"
                    x:Name="AxisNameText"
                    Text="Axis Name"
                    Style="{StaticResource SubtitleTextBlockStyle}"/>

                <!-- Value Display -->
                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Value -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Current Value" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:ConnectionId='16' 
                            x:Name="CurrentValueText"
                            Text="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Min Value -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Min" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:ConnectionId='15' 
                            x:Name="MinValueText"
                            Text="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Max Value -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Max" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:ConnectionId='14' 
                            x:Name="MaxValueText"
                            Text="65535"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar for Raw Value -->
                <ProgressBar x:ConnectionId='9' 
                    Grid.Row="2"
                    x:Name="ValueBar"
                    Value="0"
                    Maximum="65535"
                    Height="8"
                    CornerRadius="4"/>

                <!-- Calibration Controls -->
                <Grid Grid.Row="3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Min Value" FontSize="12" Opacity="0.7"/>
                        <NumberBox x:ConnectionId='13' 
                            x:Name="MinInput"
                            Minimum="0"
                            Maximum="65535"
                            SpinButtonPlacementMode="Inline"
                                                                    />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Max Value" FontSize="12" Opacity="0.7"/>
                        <NumberBox x:ConnectionId='12' 
                            x:Name="MaxInput"
                            Minimum="0"
                            Maximum="65535"
                            SpinButtonPlacementMode="Inline"
                                                                    />
                    </StackPanel>
                </Grid>

                <!-- Dead Zone Control -->
                <StackPanel Grid.Row="4" Spacing="8">
                    <TextBlock Text="Dead Zone" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:ConnectionId='10' 
                            Grid.Column="0"
                            x:Name="DeadZoneSlider"
                            Minimum="0"
                            Maximum="10000"
                            Value="0"
                                                            />
                        <TextBlock x:ConnectionId='11' 
                            Grid.Column="1"
                            x:Name="DeadZoneValue"
                            Text="0"
                            VerticalAlignment="Center"
                            TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </TabViewItem>

        <!-- Response Curve Tab -->
        <TabViewItem Header="Response Curve">
            <Grid RowSpacing="12" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Curve Presets Dropdown -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Curve Preset" FontSize="14" FontWeight="SemiBold"/>
                    <ComboBox x:ConnectionId='7' 
                        x:Name="CurvePresetCombo"
                                                               
                        SelectedIndex="0">
                        <ComboBoxItem>Racing Brake (Aggressive)</ComboBoxItem>
                        <ComboBoxItem>Smooth Throttle (Soft)</ComboBoxItem>
                        <ComboBoxItem>Precise Steering (Custom)</ComboBoxItem>
                        <ComboBoxItem>Linear (1:1)</ComboBoxItem>
                        <ComboBoxItem>Custom</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Curve Type Selection -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="Curve Type" FontSize="14" FontWeight="SemiBold"/>
                    <ComboBox x:ConnectionId='6' 
                        x:Name="CurveTypeCombo"
                                                             
                        SelectedIndex="0">
                        <ComboBoxItem>Linear (1:1)</ComboBoxItem>
                        <ComboBoxItem>Exponential (Soft)</ComboBoxItem>
                        <ComboBoxItem>Logarithmic (Aggressive)</ComboBoxItem>
                        <ComboBoxItem>Custom</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Curve Graph Canvas -->
                <Border Grid.Row="2" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,12">
                    <Canvas x:ConnectionId='5' 
                        x:Name="CurveCanvas"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        MinHeight="300"
                                                             />
                </Border>

                <!-- Curve Strength Control -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <TextBlock Text="Curve Strength" FontSize="14" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:ConnectionId='3' 
                            Grid.Column="0"
                            x:Name="CurveStrengthSlider"
                            Minimum="0.5"
                            Maximum="2.0"
                            Value="1.0"
                                                                 />
                        <TextBlock x:ConnectionId='4' 
                            Grid.Column="1"
                            x:Name="CurveStrengthValue"
                            Text="1.0"
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            FontSize="14"
                            FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>

                <!-- Description -->
                <TextBlock x:ConnectionId='2' 
                    Grid.Row="4"
                    x:Name="CurveDescription"
                    Text="Linear: Perfect 1:1 mapping"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Opacity="0.7"/>
            </Grid>
        </TabViewItem>
    </TabView>
</UserControl>

